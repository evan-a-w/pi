{
	"name": "@earendil-works/pi-web",
	"version": "0.85.1",
	"description": "Web UI for the pi coding agent. Static assets served by pi --web; speaks the pi RPC protocol over WebSocket.",
	"type": "module",
	"scripts": {
		"clean": "shx rm -rf dist",
		"dev": "vite",
		"dev:bridge": "tsx src/bridge.ts",
		"build": "vite build",
		"prepublishOnly": "npm run clean && npm run build"
	},
	"files": [
		"dist/**/*",
		"README.md"
	],
	"keywords": [
		"web",
		"ui",
		"preact",
		"coding-agent",
		"cli"
	],
	"author": "Mario Zechner",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/earendil-works/pi-mono",
		"directory": "packages/web"
	},
	"dependencies": {
		"@preact/signals": "2.10.0",
		"@xterm/addon-fit": "0.11.0",
		"@xterm/xterm": "6.0.0",
		"diff": "8.0.4",
		"dompurify": "3.4.12",
		"highlight.js": "10.7.3",
		"marked": "18.0.5",
		"preact": "10.29.7"
	},
	"devDependencies": {
		"@preact/preset-vite": "2.10.6",
		"@types/diff": "7.0.2",
		"@types/ws": "8.18.1",
		"shx": "0.4.0",
		"tsx": "4.22.1",
		"vite": "8.1.5",
		"ws": "8.21.1"
	}
}
